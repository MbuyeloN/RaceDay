@model List<RaceDay.MVC.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "My Registrations";
}

<div class="container py-4">
    <h1 class="fw-bold" style="color:#173b75;">
        My Registrations
    </h1>

    <p>View the sporting events you have registered for.</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }
    else if (Model == null || Model.Count == 0)
    {
        <div class="card p-4">
            <p class="mb-0">
                You have not registered for any events yet.
            </p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var enrolment in Model)
            {
                <div class="col-md-4">
                    <div class="card p-4 h-100">
                        <h4 style="color:#173b75;">
                            Registration #@enrolment.EnrolmentID
                        </h4>

                        <p>
                            <strong>Event ID:</strong>
                            @enrolment.EventID
                        </p>

                        <p>
                            <strong>Category ID:</strong>
                            @enrolment.CategoryID
                        </p>

                        <p>
                            <strong>Registration Date:</strong>
                            @enrolment.EnrolmentDate.ToString("dd MMM yyyy")
                        </p>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Participant"
           asp-action="Index"
           style="color:#173b75;font-weight:700;">
            Back to My Dashboard
        </a>
    </div>
</div>
